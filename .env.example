# ============================================================
#  CREDENCIAIS — copie este arquivo para .env e preencha
#  NUNCA commite o .env no Git
# ============================================================

# Anthropic (obrigatório)
# Crie em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-SuaChaveAqui

# ElevenLabs (opcional — usa gTTS gratuito se não preenchido)
# Crie em: https://elevenlabs.io
ELEVENLABS_API_KEY=

# Telegram (opcional — notificações de postagem e erros)
# Crie um bot em: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TikTok (opcional — para postagem nativa)
# Crie o app em: https://developers.tiktok.com
# Rode: python tiktok.py --setup
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Fundos e músicas (gratuito)
# Pexels — vídeos de natureza, céu, luz
# Crie conta em: https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay — músicas instrumentais
# Crie conta em: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Fundos por IA (opcional — ComfyUI + LTX). FUNDO_IA=0 mantém os fundos Pexels de fundos/
# Gerar clipes (GPU):  python fundos_ia.py --gerar --dry-run   (veja CLAUDE.md)
FUNDO_IA=0
COMFYUI_URL=http://127.0.0.1:8188
# Só se houver proxy autenticado na frente do ComfyUI remoto (Bearer)
COMFYUI_TOKEN=
